# Cloudflare Pages header rules. Generated into public/_headers by
# scripts/build-client.js — edit this template, not the output.
#
# The CDN placeholder below is replaced with the R2 public base origin at build
# time, so the CSP allows the reader to fetch chapter JSON from it. When
# R2_PUBLIC_BASE_URL is not set it collapses to nothing, separator included, and
# the CSP stays as strict as before.
#
# Cloudflare Workers Assets serves and honours this file, so these headers apply
# to every static response. The Worker sets the same policy on its own JSON
# responses, which never pass through here.
#
# connect-src also allows the R2 S3 endpoint: the admin page uploads an EPUB
# straight there with a presigned PUT. Readers never contact that host.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://*.byteimg.com https://*.googleusercontent.com https://lh3.googleusercontent.com; connect-src 'self' https://*.supabase.co https://*.r2.cloudflarestorage.com https://cloudflareinsights.com https://*.cloudflareinsights.com; media-src 'none'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' mailto:
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Robots-Tag: noarchive

# Build output carries a content hash in its query string, so it can be cached
# for a year. Pages matches on path, and the query does not affect the rule.
/app.js
  Cache-Control: public, max-age=31536000, immutable
/style.css
  Cache-Control: public, max-age=31536000, immutable
/admin-upload.js
  Cache-Control: public, max-age=31536000, immutable
/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/library/covers/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# The entry document must never cache so a new build is picked up immediately.
/
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
