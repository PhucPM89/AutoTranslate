# Cloudflare Pages header rules. Generated into public/_headers by
# scripts/build-client.js — edit this template, not the output.
#
# %CDN_ORIGIN% is replaced with the R2 public base origin at build time so the CSP
# allows the reader to fetch chapter JSON from it. When R2_PUBLIC_BASE_URL is not
# set the placeholder collapses to nothing and the CSP stays as strict as before.
#
# connect-src also allows the R2 S3 endpoint: the admin page uploads an EPUB
# straight there with a presigned PUT. Readers never contact that host.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: %CDN_ORIGIN% https://*.public.blob.vercel-storage.com; connect-src 'self' %CDN_ORIGIN% https://*.supabase.co https://*.r2.cloudflarestorage.com https://*.public.blob.vercel-storage.com https://*.blob.vercel-storage.com; media-src 'none'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' mailto:
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Build output carries a content hash in its query string, so it can be cached
# for a year. Pages matches on path, and the query does not affect the rule.
/app.js
  Cache-Control: public, max-age=31536000, immutable
/style.css
  Cache-Control: public, max-age=31536000, immutable
/admin-upload.js
  Cache-Control: public, max-age=31536000, immutable
/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/library/covers/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# The entry document must revalidate so a new build is picked up immediately.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
