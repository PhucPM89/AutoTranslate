{
  "name": "epub-translator",
  "version": "1.0.0",
  "description": "Personal EPUB reader and Chinese to Vietnamese translator using Gemini API.",
  "main": "worker/index.js",
  "scripts": {
    "build": "node scripts/build-client.js",
    "postinstall": "node scripts/build-client.js",
    "setup:admin": "node scripts/setup-admin-env.js",
    "dev": "wrangler pages dev public --compatibility-flags nodejs_compat",
    "configure:cf": "node scripts/configure-cloudflare.js",
    "deploy": "node scripts/deploy-pages.js",
    "test": "node --test \"server/**/*.test.js\" \"client/**/*.test.js\""
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "wrangler": "^4.124.0"
  }
}
