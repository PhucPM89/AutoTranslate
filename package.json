{
  "name": "epub-translator",
  "version": "1.0.0",
  "description": "Personal EPUB reader and Chinese to Vietnamese translator using Gemini API.",
  "main": "worker/index.js",
  "scripts": {
    "build": "node scripts/build-client.js",
    "postinstall": "node scripts/build-client.js",
    "setup:admin": "node scripts/setup-admin-env.js",
    "dev": "wrangler pages dev public --compatibility-flags nodejs_compat",
    "configure:cf": "node scripts/configure-cloudflare.js",
    "convert": "node scripts/convert-chapter.js",
    "build:convert": "node scripts/build-convert-dicts.js",
    "deploy": "node scripts/deploy-pages.js",
    "test": "node --test \"server/*.test.js\" \"server/storage/*.test.js\" \"client/*.test.js\"",
    "translate:hachimi": "node scripts/hachimi-translate.js",
    "chapters:live": "node scripts/live-chapters.js",
    "progress": "node scripts/check-progress.js",
    "progress:watch": "node scripts/check-progress.js --watch",
    "qa:review": "node scripts/gemini-qa-reviewer.js",
    "qa:daemon": "node scripts/gemini-qa-reviewer.js --continuous",
    "qa:pilot": "node scripts/gemini-qa-reviewer.js --max-chapters 20",
    "qa:batch": "node scripts/gemini-batch-reviewer.js",
    "qa:batch:poll": "node scripts/gemini-batch-reviewer.js --poll-only",
    "qa:backfill": "node scripts/semantic-qa-backfill.js",
    "qa:status": "node scripts/semantic-qa-status.js",
    "catalog:refresh": "node scripts/refresh-catalog.js",
    "convert:backfill": "node scripts/convert-backfill.js",
    "build:tm": "node scripts/build-tm.js"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "jszip": "^3.10.1",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "wrangler": "^4.124.0"
  }
}
