# The build reads these and writes deploy artifacts from them, so their line
# endings must not depend on the machine that did the checkout.
client/_headers.template text eol=lf
public/_headers         text eol=lf

# Functions run on the Workers runtime; keep them LF like the rest of the source.
functions/**/*.js       text eol=lf

# Convert dictionaries are generated by scripts/build-convert-dicts.js from
# community data packs. Pin LF (the repo is developed on Windows) and mark them
# generated/binary so they never produce CRLF churn, diff noise, or line-level
# merge conflicts. To change them, regenerate rather than hand-merge.
data/convert/hanviet-chars.txt          text eol=lf linguist-generated
data/convert/phrases/vietphrase.txt.gz  binary linguist-generated

# The curated convert tables are hand-maintained, unlike the generated
# dictionaries above: pin LF so a Windows checkout does not rewrite them, but
# leave them diffable — a wrong reading is meant to be reviewed line by line.
data/convert/pos/*.txt          text eol=lf
data/convert/names/*.txt        text eol=lf
data/convert/overrides-*.txt    text eol=lf
data/convert/phrase-blocklist.txt text eol=lf
data/convert/samples/*.txt      text eol=lf
