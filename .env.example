# Placeholders only. Real values live in .env.local (gitignored), in GitHub
# Actions secrets for the workers, and in the Cloudflare Worker's variables and
# secrets for the site.

# ---- Translation Provider: HachimiMT (Google Colab GPU) or Groq / Gemini ---
# Option 1: HachimiMT on Google Colab (100% Free GPU T4 via Colab Notebook)
# Chạy notebook colab/hachimi_colab_server.ipynb và dán link public URL vào đây:
TRANSLATION_PROVIDER=hachimi
HACHIMI_API_URL=https://your-colab-tunnel.trycloudflare.com
HACHIMI_MODEL=ngocdang83/HachimiMT-60-QT

# Option 2: Cloud LLM APIs (Groq / Gemini)
GROQ_API_KEYS=gsk_placeholder_1,gsk_placeholder_2
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b
GEMINI_API_KEY=your_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-2.5-pro
# Separate from background translation; configure as a Cloudflare Pages secret.
EPUB_STUDIO_API_KEYS=vip_key_1,vip_key_2
# Small chunks reduce output truncation on providers capped at 4096 output tokens.
GEMINI_CHUNK_SIZE=1800
GEMINI_TRANSLATE_CONCURRENCY=1

# ---- Cloudflare R2 -----------------------------------------------------------
# Public reader bucket: chapters, covers, catalogue snapshot.
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET=novel-storage
# Private bucket: source EPUBs and crawler state. Must not be publicly reachable.
R2_ARCHIVE_BUCKET=novel-archive
# The only R2 value the browser is allowed to know.
R2_PUBLIC_BASE_URL=https://cdn.example.com
# Optional: overrides the derived S3 endpoint.
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# ---- Supabase ----------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
# Browser-safe. RLS restricts it to reading published metadata and inserting
# analytics events.
SUPABASE_ANON_KEY=your_publishable_key
# Server-side only: the ingest and translation workers. NEVER in a browser bundle.
SUPABASE_SERVICE_ROLE_KEY=your_secret_key

# ---- Admin (Cloudflare Worker) ----------------------------------------------
# Generate with: npm run setup:admin
LIBRARY_UPLOAD_PASSWORD_HASH=scrypt$salt$hash
# Signs the admin session cookie. Any random value; changing it signs everyone out.
LIBRARY_SESSION_SECRET=random_secret
# Fine-grained PAT, Actions: read and write, this repository only. Lets the admin
# page start an ingest run.
GITHUB_DISPATCH_TOKEN=github_pat_xxx
GITHUB_REPOSITORY=owner/repo

# ---- Reader feature flag ------------------------------------------------------
# Chapters are read from the CDN only when this is true AND R2_PUBLIC_BASE_URL is
# set. Leave unset until the CDN reader has been validated by hand.
# READER_CDN_ENABLED=true

# ---- Translation worker tuning ------------------------------------------------
# The dedicated workflow uses a four-chapter batch and serializes all R2 pipeline
# writers through one GitHub Actions concurrency group.
TRANSLATE_SPACING_MS=500
TRANSLATE_BUDGET=150
TRANSLATE_RUN_MINUTES=300
# How often to republish index.json mid-run so readers see progress.
TRANSLATE_PUBLISH_EVERY=25

# ---- Ingest ------------------------------------------------------------------
INGEST_TRANSLATE=false
INGEST_TRANSLATE_BUDGET=0

# ---- Offline convert tier ----------------------------------------------------
# Renders every chapter as a readable Vietnamese convert at ingest, with no API
# and no quota, so the crawler never outruns translation into a pile of
# unreadable Chinese. On by default when the dictionaries in data/convert/ exist.
# CONVERT_ENABLED=false          # publish raw source instead (old behaviour)
# CONVERT_HANVIET=data/convert/hanviet-chars.txt          # single-char phonetic
# CONVERT_PHRASES=data/convert/phrases/vietphrase.txt.gz  # multi-char phrases

# ---- Local development -------------------------------------------------------
# With no R2_* credentials the storage layer writes here instead, so the whole
# ingest pipeline runs offline.
LOCAL_STORAGE_DIR=.storage
LOCAL_PUBLIC_BASE_URL=/local-cdn
